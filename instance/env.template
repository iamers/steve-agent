# Template delle chiavi richieste in ~/.hermes/.env per una istanza Steve.
# L'installer Hermes semina un .env con centinaia di righe commentate: queste
# sono le SOLE chiavi che una istanza Steve deve valorizzare in coda al file.
# Compilare server-side come utente dell'istanza. MAI committare valori reali.
# Gotcha: il .env seminato non termina con newline; appendere con printf "\n...".

# LLM backend — Z.AI GLM coding plan (endpoint esplicito = deterministico)
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Canale Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=            # user id ammessi, comma-separated
TELEGRAM_GROUP_ALLOWED_CHATS=      # chat_id del forum group (es. -100...)
TELEGRAM_HOME_CHANNEL=             # destinazione output proattivi (= chat_id gruppo)
TELEGRAM_HOME_CHANNEL_NAME=        # etichetta leggibile

# Telegram admin user id (numeric). Interpolated into config.yaml allow lists
# (allow_admin_from, group_allow_admin_from) as '${TELEGRAM_ADMIN_ID}'.
# Never commit the real value.
TELEGRAM_ADMIN_ID=

# Opzionali, da valorizzare quando servono (routing cron su topic dedicato):
# TELEGRAM_CRON_THREAD_ID=
# TELEGRAM_HOME_CHANNEL_THREAD_ID=

# Default seminati non-commentati dall'installer (v2026.7.1): documentati qui
# perché drift-check confronta i nomi delle chiavi valorizzate. Non toccarli
# se non serve; se l'installer cambia i seed, aggiornare questa sezione.
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300
BROWSERBASE_PROXIES=true
BROWSERBASE_ADVANCED_STEALTH=false
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# vLLM lab endpoint (named custom provider "lab-gpu"): URL and key live only here
VLLM_BASE_URL=
VLLM_API_KEY=

# Privacy guard: path to the local denylist of forbidden strings.
# check_privacy.sh reads this file to block commits containing sensitive tokens.
# Default (.local/privacy-denylist.txt) works for clones with the symlink;
# for instance deployments, point this to the instance denylist file.
# Empty = fall back to the default; the coordinator sets the absolute path here.
PRIVACY_DENYLIST=

# SSH host/alias of the instance for drift-check.sh and smoke scripts.
# Pass as arg1 to those scripts, or export STEVE_HOST. If unset and no arg1
# is given, the scripts exit with an explicit error (no silent fallback).
STEVE_HOST=
